@@ -0,0 +1,151 @@
+from math import radians, sin
+
+import isaacgym
+assert isaacgym
+from isaacgym.torch_utils import quat_apply
+import torch
+
+from go1_gym.envs.base.legged_robot import LeggedRobot
+from go1_gym.envs.go1.velocity_tracking import VelocityTrackingEasyEnv
+
+
+class T3ForwardEnv(VelocityTrackingEasyEnv):
+    # Same command and per-joint targets as the Robohack T3 Participant.
+    TROT = (0, 0, 0, 0, 3, 0.5, 0, 0, 0.5, 0.08, 0, 0, 0.33, 0.40, 0)
+    JOINT_LIMITS = {"hip": (-0.863, 0.863), "thigh": (-0.686, 4.501), "calf": (-2.818, -0.888)}
+    TARGET_INTERVAL = 0.010
+    MAX_TARGET_STEP = radians(5.0) - 0.001
+    PASSIVE_DAMPING = {"hip": 1.0, "thigh": 2.0, "calf": 2.0}
+    LATERAL_ERROR_SCALE_M = 0.60
+    HEADING_ERROR_SCALE_RAD = radians(20)
+    VALIDATION_SPEED_MPS = 0.60
+    VALIDATION_WARMUP_S = 1.5
+    VALIDATION_HORIZON_S = 12.0
+    VALIDATION_DISTANCE_M = 3.0
+    VALIDATION_FALL_S = 0.5
+
+    def __init__(self, *args, straightness_weight=0.0, **kwargs):
+        self.straightness_weight = straightness_weight
+        self.validation_active = False
+        super().__init__(*args, **kwargs)
+
+    def _init_command_distribution(self, env_ids):
+        # Fixed commands sampled directly on the simulation device.
+        self.env_command_bins = torch.zeros(self.num_train_envs, device=self.device)
+        self.trot_command = torch.tensor(self.TROT, dtype=torch.float32, device=self.device)
+
+    def _call_train_eval(self, func, env_ids):
+        if self.num_eval_envs and func in (self._get_env_origins, self._reset_dofs, self._reset_root_states):
+            # The two groups share the plane and reset parameters. Set each indexed state tensor once per step.
+            if len(env_ids):
+                return func(env_ids, self.cfg)
+            return None
+        return super()._call_train_eval(func, env_ids)
+
+    def _resample_commands(self, env_ids):
+        if len(env_ids) == 0:
+            return
+        low, high = self.cfg.commands.lin_vel_x
+        self.commands[env_ids] = self.trot_command
+        forward = torch.rand(len(env_ids), device=self.device) * (high - low) + low
+        if self.num_eval_envs:
+            forward.masked_fill_(env_ids >= self.num_train_envs, self.VALIDATION_SPEED_MPS)
+        self.commands[env_ids, 0] = forward
+        for values in self.command_sums.values():
+            values[env_ids] = 0
+
+    def _process_dof_props(self, props, env_id):
+        props["damping"][:] = [self.PASSIVE_DAMPING[name.split("_")[1]] for name in self.dof_names]
+        return super()._process_dof_props(props, env_id)
+
+    def _init_buffers(self):
+        super()._init_buffers()
+        self.course_origin_xy = torch.empty_like(self.base_pos[:, :2])
+        self.course_forward_xy = torch.empty_like(self.course_origin_xy)
+        self.straightness_step_weight = self.straightness_weight * self.dt
+        # Look up limits by joint name so they follow the Isaac Gym DOF order.
+        limits = [self.JOINT_LIMITS[name.split("_")[1]] for name in self.dof_names]
+        self.target_lower, self.target_upper = torch.tensor(limits, device=self.device).T
+        self.target_ticks = round(self.TARGET_INTERVAL / self.sim_params.dt)
+        if self.target_ticks < 1 or abs(self.target_ticks * self.sim_params.dt - self.TARGET_INTERVAL) > 1e-6:
+            raise ValueError("The physics timestep must evenly divide the 10 ms target interval")
+        if self.cfg.control.decimation % self.target_ticks != 0:
+            raise ValueError("The policy period must be a multiple of the target interval")
+
+    def reset_idx(self, env_ids):
+        super().reset_idx(env_ids)
+        self.joint_pos_target[env_ids] = self.default_dof_pos
+        if len(env_ids):
+            # Upstream reset_idx has written the new pose to root_states.
+            self.course_origin_xy[env_ids] = self.root_states[env_ids, :2]
+            forward = quat_apply(self.root_states[env_ids, 3:7], self.forward_vec[env_ids])
+            self.course_forward_xy[env_ids] = torch.nn.functional.normalize(forward[:, :2], dim=1)
+
+    def compute_reward(self):
+        super().compute_reward()
+        # Upstream computes rewards after refreshing physics and before resetting finished envs.
+        displacement = self.base_pos[:, :2] - self.course_origin_xy
+        heading = quat_apply(self.base_quat, self.forward_vec)[:, :2]
+        course_x, course_y = self.course_forward_xy.unbind(dim=1)
+        self.lateral_offset = course_x * displacement[:, 1] - course_y * displacement[:, 0]
+        self.heading_error = torch.atan2(course_x * heading[:, 1] - course_y * heading[:, 0],
+                                         course_x * heading[:, 0] + course_y * heading[:, 1])
+        self.course_forward_velocity = (self.root_states[:, 7:9] * self.course_forward_xy).sum(dim=1)
+        if self.validation_active:
+            evaluation = slice(self.num_train_envs, None)
+            gravity = self.projected_gravity[evaluation]
+            roll = torch.atan2(-gravity[:, 1], -gravity[:, 2]).abs()
+            self.validation_unstable = ((self.base_pos[evaluation, 2] < 0.16)
+                                        | (gravity[:, 0].abs() > sin(radians(50)))
+                                        | (roll > radians(50)))
+            self.validation_forward = (displacement[evaluation] * self.course_forward_xy[evaluation]).sum(dim=1)
+        if self.straightness_step_weight:
+            lateral_sq = (self.lateral_offset / self.LATERAL_ERROR_SCALE_M).square()
+            heading_sq = (self.heading_error / self.HEADING_ERROR_SCALE_RAD).square()
+            # Average two bounded x²/(1+x²) costs after the baseline reward shaping.
+            cost = 1 - 0.5 * (1 / (1 + lateral_sq) + 1 / (1 + heading_sq))
+            penalty = cost * self.straightness_step_weight
+            self.rew_buf.sub_(penalty)
+            self.episode_sums["total"].sub_(penalty)
+
+    def check_termination(self):
+        super().check_termination()
+        if self.validation_active:
+            # Continue measuring the same evaluation episode even when the training task would reset it.
+            self.reset_buf[self.num_train_envs:] = False
+
+    def begin_validation(self):
+        state = (self.common_step_counter, self.gravities[0].clone())
+        super()._randomize_gravity(torch.zeros_like(state[1]))
+        self.validation_active = True
+        return state
+
+    def end_validation(self, state):
+        self.validation_active = False
+        self.common_step_counter, gravity = state
+        super()._randomize_gravity(gravity)
+
+    def _randomize_gravity(self, external_force=None):
+        if not self.validation_active:
+            super()._randomize_gravity(external_force)
+
+    def _set_joint_pos_target(self, target):
+        if self.target_substep % self.target_ticks == 0:
+            valid = torch.isfinite(target).all(dim=1, keepdim=True)
+            target = torch.clamp(target, self.target_lower, self.target_upper)
+            delta = (target - self.joint_pos_target).clamp(-self.MAX_TARGET_STEP, self.MAX_TARGET_STEP)
+            self.joint_pos_target = torch.where(valid, self.joint_pos_target + delta, self.joint_pos_target)
+        self.target_substep += 1
+
+    def step(self, actions):
+        self.target_substep = 0
+        self.extras.pop("train/episode", None)
+        forward_command = self.commands[:, 0].clone()
+        obs, privileged_obs, reward, done, info = LeggedRobot.step(self, actions)
+        # Keep rollout data on the simulation device. The command may have changed in reset_idx.
+        info.update(privileged_obs=privileged_obs, env_bins=self.env_command_bins,
+                    time_outs=self.time_out_buf[:self.num_train_envs],
+                    forward_velocity=self.base_lin_vel[:, 0], forward_command=forward_command,
+                    lateral_offset=self.lateral_offset, heading_error=self.heading_error,
+                    course_forward_velocity=self.course_forward_velocity)
+        return obs, reward, done, info
